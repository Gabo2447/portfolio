---
import "@/styles/global.css";
import Navbar from "@/components/nav/Navbar.astro";
import Footer from "@/components/footer/Footer.astro";

const { title = "Main" } = Astro.props;
---

<!doctype html>
<html lang="en" class="flex justify-center bg-surface-bg text-surface-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col justify-center pt-20">
    <Navbar />
    <main class="flex-1 w-full max-w-360 mx-auto px-responsive flex flex-col items-center justify-center">
      <slot />
    </main>
    <Footer />
  </body>
</html>
