---
import { Font } from "astro:assets";
import "@/styles/global.css";

import Navbar from "@/components/nav/Navbar.astro";
import Footer from "@/components/footer/Footer.astro";
import BackgroundIcon from "@/components/background/BackgroundIcon.astro";

import type { HeaderContent, FooterContent } from "@/types/i18n";

interface Props {
  title?: string;
  lang?: string;
  navbar: HeaderContent;
  footer: FooterContent;
  baseURL: string;
}

const { title = "Main", lang = "es", navbar, footer, baseURL } = Astro.props;

const formattedBase = baseURL.endsWith("/") ? baseURL : `${baseURL}/`;
---

<!doctype html>
<html lang={lang} class="flex justify-center text-surface-white no-scrollbar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${formattedBase}logo-dark.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-instrument-sans" preload />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col justify-center">
    <BackgroundIcon />
    <Navbar content={navbar} />
    <main class="flex-1 w-full max-w-360 mx-auto px-responsive my-10 z-50 flex flex-col items-center justify-center">
      <slot />
    </main>
    <Footer content={footer} />
  </body>
</html>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  if (theme === "dark") {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }
</script>
