---
import { Font } from "astro:assets";
import "@/styles/global.css";

import Navbar from "@/components/nav/Navbar.astro";
import Footer from "@/components/footer/Footer.astro";
import BackgroundIcon from "@/components/background/BackgroundIcon.astro";

import type { HeaderContent, FooterContent } from "@/types/i18n";

interface Props {
  title?: string;
  lang?: string;
  navbar: HeaderContent;
  footer: FooterContent;
  baseURL: string;
}

const { title = "Main", lang = "en", navbar, footer, baseURL } = Astro.props;

const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} class="flex justify-center text-surface-white dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}logo-dark.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-instrument-sans" preload />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col justify-center">
    <BackgroundIcon />
    <Navbar content={navbar} />
    <main class="flex-1 w-full max-w-360 mx-auto px-responsive flex flex-col items-center justify-center">
      <slot />
    </main>
    <Footer content={footer} />
  </body>
</html>
