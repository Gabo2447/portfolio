---

import type { HTMLTag, Polymorphic } from 'astro/types';
import { twMerge } from 'tailwind-merge';

type Props<T extends HTMLTag = 'button'> = Polymorphic<{ as: T }>;

const {
  as: Tag = 'button',
  class: customClass,
  ...restProps
} = Astro.props;

const defaultClasses = "px-6 py-3 rounded-lg font-medium no-underline transition-all duration-200 bg-surface-card border border-solid border-white/10 hover:bg-white/5 active:scale-95";
const finalClasses = twMerge(defaultClasses, customClass);
---

<Tag {...restProps} class:list={[finalClasses]}>
  <slot />
</Tag>