---
import type { FooterContent } from "@/types/i18n";
import { typedEntries } from "@/utils/typedEntries";
import Title from "@/components/common/Title.astro";

interface Props {
  content: FooterContent;
}

const { content } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="text-surface-white w-screen relative mt-10 bg-card">
  <div class="max-w-360 mx-auto border-t border-border">
    <div class="flex flex-col items-center text-center gap-8 py-10 px-responsive md:flex-row md:items-start md:justify-between md:text-left">
      <!-- Logo -->
      <Title Tag="span" textEnable />

      {typedEntries(content).map(([key, value]) => {
        const title = key;

        const mappedValue = value.map((item) => {
          return (
            <li>
              <a
                href={item.href}
                class="animated-underline capitalize transition-colors duration-100 hover:text-foreground"
                target={item?.target}
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            </li>
          );
        });

        return (
          <nav aria-label={title} class="flex flex-col gap-y-5">
            <span class="text-foreground text-xl font-heading capitalize">{title}</span>
            <ul class="flex flex-col gap-y-6 text-muted-foreground">{mappedValue}</ul>
          </nav>
        );
      })}

      <!-- Space -->
      <div class="hidden md:block"></div>
    </div>

    <!-- Copyright -->
    <div class="my-12 pt-6 px-responsive border-t border-surface-border text-center text-[0.875rem] text-surface-white/90 md:text-left">
      © {currentYear} Gabriel
    </div>
  </div>
</footer>
