---
import type { Link } from "@/i18n/type";
import { Icon } from "astro-icon/components";

interface Props {
  content: Link[];
}

const { content } = Astro.props;
---

<!-- Botón Toggle (Se queda en el Header) -->
<button
  id="menu-toggle"
  class="md:hidden focus:outline-none p-1 z-120 relative text-foreground"
  aria-label="Toggle Menu"
>
  <Icon id="icon-open" name="lucide:align-right" class="w-8 h-8 block" />
  <Icon id="icon-close" name="lucide:x" class="w-8 h-8 hidden" />
</button>

<!-- Fullscreen Overlay (Anclado estricto al Viewport) -->
<div
  id="mobile-menu"
  class="hidden fixed top-0 left-0 right-0 bottom-0 w-screen h-dvh bg-background/98 backdrop-blur-2xl z-110 flex-col pt-24 px-responsive md:hidden overflow-y-auto"
>
  <nav class="mt-4">
    <ul class="flex flex-col items-start gap-y-6 font-medium text-left">
      {content.map((item) => (
        <li class="w-full">
          <a
            href={item.href}
            class="mobile-nav-link animated-underline block py-2 text-2xl font-normal text-foreground"
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const navLinks = document.querySelectorAll(".mobile-nav-link");

    if (!toggleBtn || !mobileMenu) return;

    const toggleState = (open?: boolean) => {
      const isCurrentlyHidden = mobileMenu.classList.contains("hidden");
      const shouldOpen = open !== undefined ? open : isCurrentlyHidden;

      if (shouldOpen) {
        mobileMenu.classList.remove("hidden");
        mobileMenu.classList.add("flex");
        iconOpen?.classList.replace("block", "hidden");
        iconClose?.classList.replace("hidden", "block");

        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        document.body.style.touchAction = "none";
      } else {
        mobileMenu.classList.remove("flex");
        mobileMenu.classList.add("hidden");
        iconOpen?.classList.replace("hidden", "block");
        iconClose?.classList.replace("block", "hidden");

        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
        document.body.style.touchAction = "";
      }
    };

    toggleBtn.addEventListener("click", () => toggleState());

    navLinks.forEach((link) => {
      link.addEventListener("click", () => toggleState(false));
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
