---
import type { Link } from "@/types/i18n";

interface Props {
  content: Link[];
}

const { content } = Astro.props;
---

<div
  id="mobile-menu"
  class="hidden fixed inset-0 w-screen h-dvh bg-background/98 backdrop-blur-2xl z-110 flex-col pt-28 px-responsive md:hidden overflow-y-auto left-0 top-0"
>
  <nav class="mt-4">
    <ul class="flex flex-col items-start gap-y-6 font-medium text-left">
      {content.map((item) => (
        <li class="w-full">
          <a
            href={item.href}
            class="mobile-nav-link animated-underline block py-2 text-2xl font-normal text-foreground"
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById("menu-toggle") as HTMLElement | null;
    const mobileMenu = document.getElementById("mobile-menu") as HTMLElement | null;
    const iconOpen = document.getElementById("icon-open") as HTMLElement | null;
    const iconClose = document.getElementById("icon-close") as HTMLElement | null;
    const navLinks = document.querySelectorAll<HTMLElement>(".mobile-nav-link");

    if (!toggleBtn || !mobileMenu) return;

    const toggleState = (forceClose?: boolean) => {
      const isCurrentlyHidden = mobileMenu.classList.contains("hidden");
      const shouldOpen = forceClose !== undefined ? !forceClose : isCurrentlyHidden;

      mobileMenu.classList.toggle("hidden", !shouldOpen);
      mobileMenu.classList.toggle("flex", shouldOpen);

      iconOpen?.classList.toggle("hidden", shouldOpen);
      iconOpen?.classList.toggle("block", !shouldOpen);

      iconClose?.classList.toggle("hidden", !shouldOpen);
      iconClose?.classList.toggle("block", shouldOpen);
    };

    toggleBtn.onclick = () => toggleState();

    navLinks.forEach((link) => {
      link.onclick = () => toggleState(true);
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
