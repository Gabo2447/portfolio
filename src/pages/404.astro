---
import ButtonPrimary from "@/components/common/button/ButtonPrimary.astro";
import Layout from "../layouts/Layout.astro";
import ButtonSecondary from "@/components/common/button/ButtonSecondary.astro";
---

<Layout title="404 - Página no encontrada">
  <section class="container min-h-[90vh] flex flex-col justify-center items-center">
    <div class="error-code">404</div>
    <h1 class="title">Página no encontrada</h1>
    <p class="description">
      El enlace que seguiste tal vez está roto o la página ha sido movida a otra
      ubicación.
    </p>

    <div class="actions">
      <ButtonPrimary as="a" href="/" class="bg-primary/60">
        Volver al inicio
      </ButtonPrimary>
      <ButtonSecondary as="a" href="/docs">
        Ver documentación
      </ButtonSecondary>
    </div>
  </section>
</Layout>

<style>
  .container {
    text-align: center;
    max-width: 480px;
    width: 100%;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-color);
    letter-spacing: -2px;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.1s;
  }

  .btn-primary {
    background-color: var(--accent-color);
    color: #ffffff;
  }
</style>
