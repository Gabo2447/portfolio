---
import Layout from "@/layouts/Layout.astro";

import { Button } from "@/components/ui/button";
import { DynamicIcon } from "@/components/icons/Icon";
import { ESLang } from "#/data";

const t = ESLang;

const navbar = t.navbar;
const footer = t.footer;
const errorPage = t.sections.errorPage;
---

<Layout title="404 - Not Found" navbar={navbar} footer={footer} baseURL={t.prefix}>
  <section class="container min-h-[90vh] flex flex-col justify-center items-center z-1">
    <div class="text-[8rem] font-extrabold leading-none tracking-[-2px] mb-2 font-heading">{errorPage.code}</div>
    <h1 class="text-[1.55rem] font-semibold font-heading mb-3">{errorPage.title}</h1>
    <p class="text-muted-foreground leading-normal mb-8 max-w-140 text-center">{errorPage.description}</p>

    <div class="actions flex gap-4 justify-center flex-wrap">
      {errorPage.buttons?.map((btn) => {
        return (
          <Button variant={btn.variant} size="lg" className="px-8">
            <a href={btn.href} target={btn.target}>
              <DynamicIcon client:load name={btn.icon} />
              {btn.name}
            </a>
            {}
          </Button>
        );
      })}
    </div>
  </section>
</Layout>
