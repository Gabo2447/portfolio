# https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.astro,*.html,*.css,*.scss,*.js,*.ts,*.jsx,*.tsx,*.json,*.json5,*.md,*.yml,*.toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false